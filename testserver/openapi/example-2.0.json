{
  "swagger": "2.0",
  "info": {
    "title": "Widgets (sample)",
    "description": "A small but valid Swagger 2.0 doc used to exercise Yon's OpenAPI import.",
    "version": "1.0.0"
  },
  "host": "api.widgets.example.com",
  "basePath": "/v2",
  "schemes": ["https"],
  "tags": [
    { "name": "widgets", "description": "Widget operations" }
  ],
  "securityDefinitions": {
    "apiKey": {
      "type": "apiKey",
      "name": "X-API-Key",
      "in": "header"
    }
  },
  "paths": {
    "/widgets": {
      "get": {
        "tags": ["widgets"],
        "summary": "List widgets",
        "operationId": "listWidgets",
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "A list of widgets.",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/definitions/Widget" }
            }
          }
        }
      },
      "post": {
        "tags": ["widgets"],
        "summary": "Create a widget",
        "operationId": "createWidget",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "security": [{ "apiKey": [] }],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/NewWidget" }
          }
        ],
        "responses": {
          "201": {
            "description": "Widget created.",
            "schema": { "$ref": "#/definitions/Widget" }
          }
        }
      }
    }
  },
  "definitions": {
    "Widget": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "integer", "format": "int64" },
        "name": { "type": "string" },
        "color": { "type": "string" }
      }
    },
    "NewWidget": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "color": { "type": "string" }
      }
    }
  }
}
