{
  "version": 1,
  "name": "Yon Test Server",
  "auth": {
    "kind": "bearer",
    "token": "yon-demo-token"
  },
  "variables": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7878",
      "enabled": true
    },
    {
      "key": "bearerToken",
      "value": "yon-demo-token",
      "enabled": true
    },
    {
      "key": "oauthClientId",
      "value": "yon-client",
      "enabled": true
    },
    {
      "key": "oauthClientSecret",
      "value": "yon-secret",
      "enabled": true
    }
  ],
  "activeEnvironment": "Local",
  "folders": [
    {
      "id": "fmethods",
      "name": "Methods & Echo"
    },
    {
      "id": "fauth",
      "name": "Auth (Bearer / Basic)"
    },
    {
      "id": "fstatus",
      "name": "Status, Redirect & Overrides"
    },
    {
      "id": "fformats",
      "name": "Body & Formats (JSON / XML / HTML / SOAP)"
    },
    {
      "id": "fbig",
      "name": "Large & Slow (truncation / cancel)"
    },
    {
      "id": "fmedia",
      "name": "Media — image & PDF (#16)"
    },
    {
      "id": "ftestchain",
      "name": "Tests & Chaining"
    },
    {
      "id": "foauth",
      "name": "OAuth 2.0 (#30)"
    },
    {
      "id": "fform",
      "name": "Form & Multipart (#48)"
    }
  ],
  "requests": [
    {
      "name": "OAuth2 client_credentials → protected (#30)",
      "method": "GET",
      "url": "{{baseUrl}}/oauth/protected",
      "auth": {
        "kind": "oauth2",
        "oauth2": {
          "grant": "client_credentials",
          "tokenUrl": "{{baseUrl}}/oauth/token",
          "clientId": "{{oauthClientId}}",
          "clientSecret": "{{oauthClientSecret}}",
          "scopes": "read",
          "clientAuth": "basic"
        }
      },
      "body": {
        "type": "none"
      },
      "folderId": "foauth"
    },
    {
      "name": "GET — query params + custom header",
      "method": "GET",
      "url": "{{baseUrl}}/get",
      "params": [
        {
          "key": "page",
          "value": "1",
          "enabled": true
        },
        {
          "key": "q",
          "value": "hello",
          "enabled": true
        },
        {
          "key": "debug",
          "value": "true",
          "enabled": true
        }
      ],
      "headers": [
        {
          "key": "X-Demo",
          "value": "yon",
          "enabled": true
        }
      ],
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmethods"
    },
    {
      "name": "POST — JSON body",
      "method": "POST",
      "url": "{{baseUrl}}/post",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "json",
        "content": "{\n  \"hello\": \"yon\",\n  \"n\": 42,\n  \"tags\": [\"http\", \"offline\"]\n}"
      },
      "folderId": "fmethods"
    },
    {
      "name": "PUT — JSON body",
      "method": "PUT",
      "url": "{{baseUrl}}/put",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "json",
        "content": "{ \"id\": 7, \"name\": \"updated\" }"
      },
      "folderId": "fmethods"
    },
    {
      "name": "DELETE",
      "method": "DELETE",
      "url": "{{baseUrl}}/delete",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmethods"
    },
    {
      "name": "Headers echo",
      "method": "GET",
      "url": "{{baseUrl}}/headers",
      "headers": [
        {
          "key": "X-Trace-Id",
          "value": "abc-123",
          "enabled": true
        },
        {
          "key": "Accept",
          "value": "application/json",
          "enabled": true
        }
      ],
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmethods"
    },
    {
      "name": "PATCH — echo method",
      "method": "PATCH",
      "url": "{{baseUrl}}/anything",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "json",
        "content": "{\n  \"op\": \"replace\",\n  \"value\": 7\n}"
      },
      "folderId": "fmethods"
    },
    {
      "name": "Bearer auth (inherits collection token)",
      "method": "GET",
      "url": "{{baseUrl}}/bearer",
      "auth": {
        "kind": "inherit"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fauth"
    },
    {
      "name": "Basic auth (overrides collection)",
      "method": "GET",
      "url": "{{baseUrl}}/basic-auth/alice/secret",
      "auth": {
        "kind": "basic",
        "username": "alice",
        "password": "secret"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fauth"
    },
    {
      "name": "Status 404 (orange)",
      "method": "GET",
      "url": "{{baseUrl}}/status/404",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fstatus"
    },
    {
      "name": "Status 500 (red)",
      "method": "GET",
      "url": "{{baseUrl}}/status/500",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fstatus"
    },
    {
      "name": "Redirect → /get (follows)",
      "method": "GET",
      "url": "{{baseUrl}}/redirect",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fstatus"
    },
    {
      "name": "Options — don't follow the redirect (per-request)",
      "method": "GET",
      "url": "{{baseUrl}}/redirect",
      "auth": {
        "kind": "inherit"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fstatus",
      "options": {
        "followRedirects": false
      },
      "assertions": [
        {
          "source": "status",
          "op": "equals",
          "expected": "302",
          "enabled": true
        },
        {
          "source": "header",
          "expr": "Location",
          "op": "contains",
          "expected": "/get",
          "enabled": true
        }
      ]
    },
    {
      "name": "Pretty JSON (syntax colour)",
      "method": "GET",
      "url": "{{baseUrl}}/json",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fformats"
    },
    {
      "name": "GET — XML response",
      "method": "GET",
      "url": "{{baseUrl}}/xml",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fformats"
    },
    {
      "name": "POST — XML body",
      "method": "POST",
      "url": "{{baseUrl}}/xml",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "xml",
        "content": "<order id=\"1001\"><item sku=\"A1\">Widget</item><item sku=\"B2\">Gadget</item></order>"
      },
      "folderId": "fformats"
    },
    {
      "name": "GET — HTML page",
      "method": "GET",
      "url": "{{baseUrl}}/html",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fformats"
    },
    {
      "name": "GET — SOAP envelope",
      "method": "GET",
      "url": "{{baseUrl}}/soap",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fformats"
    },
    {
      "name": "Large body (> 256 KB, truncates)",
      "method": "GET",
      "url": "{{baseUrl}}/large",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fbig"
    },
    {
      "name": "Slow 10s (test Cancel / timeout)",
      "method": "GET",
      "url": "{{baseUrl}}/slow",
      "params": [
        {
          "key": "seconds",
          "value": "10",
          "enabled": true
        }
      ],
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fbig"
    },
    {
      "name": "PNG image (inline preview)",
      "method": "GET",
      "url": "{{baseUrl}}/image/png",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmedia"
    },
    {
      "name": "JPEG image (inline preview)",
      "method": "GET",
      "url": "{{baseUrl}}/image/jpeg",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmedia"
    },
    {
      "name": "GIF image (inline preview)",
      "method": "GET",
      "url": "{{baseUrl}}/image/gif",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmedia"
    },
    {
      "name": "PNG as octet-stream (magic-byte sniff)",
      "method": "GET",
      "url": "{{baseUrl}}/image/octet",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmedia"
    },
    {
      "name": "PDF (Save… / Open panel)",
      "method": "GET",
      "url": "{{baseUrl}}/pdf",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmedia"
    },
    {
      "name": "PDF as octet-stream (magic-byte sniff)",
      "method": "GET",
      "url": "{{baseUrl}}/pdf/octet",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmedia"
    },
    {
      "name": "Text starting \"BM\" — must stay text, not an image",
      "method": "GET",
      "url": "{{baseUrl}}/text-bm",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmedia",
      "assertions": [
        {
          "source": "status",
          "op": "equals",
          "expected": "200",
          "enabled": true
        },
        {
          "source": "header",
          "expr": "Content-Type",
          "op": "contains",
          "expected": "text/plain",
          "enabled": true
        }
      ]
    },
    {
      "name": "Assertions — check the JSON response",
      "method": "GET",
      "url": "{{baseUrl}}/json",
      "auth": {
        "kind": "inherit"
      },
      "body": {
        "type": "none"
      },
      "folderId": "ftestchain",
      "assertions": [
        {
          "source": "status",
          "op": "equals",
          "expected": "200",
          "enabled": true
        },
        {
          "source": "jsonBody",
          "expr": "$.active",
          "op": "equals",
          "expected": "true",
          "enabled": true
        },
        {
          "source": "jsonBody",
          "expr": "$.score",
          "op": "greaterThan",
          "expected": "9",
          "enabled": true
        },
        {
          "source": "jsonBody",
          "expr": "$.tags[1]",
          "op": "equals",
          "expected": "offline",
          "enabled": true
        },
        {
          "source": "jsonBody",
          "expr": "$.message",
          "op": "contains",
          "expected": "request",
          "enabled": true
        },
        {
          "source": "responseTimeMs",
          "op": "lessThan",
          "expected": "2000",
          "enabled": true
        }
      ]
    },
    {
      "name": "Capture — grab id + name (step 1 of 2)",
      "method": "GET",
      "url": "{{baseUrl}}/json",
      "auth": {
        "kind": "inherit"
      },
      "body": {
        "type": "none"
      },
      "folderId": "ftestchain",
      "captures": [
        {
          "variable": "userId",
          "source": "jsonBody",
          "expr": "$.id",
          "enabled": true
        },
        {
          "variable": "appName",
          "source": "jsonBody",
          "expr": "$.name",
          "enabled": true
        }
      ],
      "assertions": [
        {
          "source": "status",
          "op": "equals",
          "expected": "200",
          "enabled": true
        }
      ]
    },
    {
      "name": "Chain — use {{userId}} captured above (step 2 of 2)",
      "method": "GET",
      "url": "{{baseUrl}}/get?user={{userId}}&app={{appName}}",
      "auth": {
        "kind": "inherit"
      },
      "body": {
        "type": "none"
      },
      "folderId": "ftestchain",
      "assertions": [
        {
          "source": "status",
          "op": "equals",
          "expected": "200",
          "enabled": true
        },
        {
          "source": "jsonBody",
          "expr": "$.query.user",
          "op": "equals",
          "expected": "42",
          "enabled": true
        },
        {
          "source": "jsonBody",
          "expr": "$.query.app",
          "op": "equals",
          "expected": "Yon",
          "enabled": true
        }
      ]
    },
    {
      "name": "Form (urlencoded) → /form (#48)",
      "method": "POST",
      "url": "{{baseUrl}}/form",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "form",
        "fields": [
          {
            "key": "name",
            "value": "yon",
            "enabled": true
          },
          {
            "key": "lang",
            "value": "go",
            "enabled": true
          }
        ]
      },
      "folderId": "fform"
    },
    {
      "name": "Multipart (text fields) → /form (#48)",
      "method": "POST",
      "url": "{{baseUrl}}/form",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "multipart",
        "fields": [
          {
            "key": "title",
            "value": "hello",
            "enabled": true
          },
          {
            "key": "tag",
            "value": "http",
            "enabled": true
          }
        ]
      },
      "folderId": "fform"
    }
  ]
}
