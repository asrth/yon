{
  "version": 1,
  "name": "Yon Test Server",
  "auth": {
    "kind": "bearer",
    "token": "yon-demo-token"
  },
  "variables": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7878",
      "enabled": true
    },
    {
      "key": "bearerToken",
      "value": "yon-demo-token",
      "enabled": true
    }
  ],
  "activeEnvironment": "Local",
  "folders": [
    {
      "id": "fmethods",
      "name": "Methods \u0026 Echo"
    },
    {
      "id": "fauth",
      "name": "Auth (Bearer / Basic)"
    },
    {
      "id": "fstatus",
      "name": "Status, Redirect \u0026 Overrides"
    },
    {
      "id": "fformats",
      "name": "Body \u0026 Formats (JSON / XML / HTML / SOAP)"
    },
    {
      "id": "fbig",
      "name": "Large \u0026 Slow (truncation / cancel)"
    },
    {
      "id": "fmedia",
      "name": "Media — image \u0026 PDF (#16)"
    },
    {
      "id": "ftestchain",
      "name": "Tests \u0026 Chaining"
    }
  ],
  "requests": [
    {
      "name": "GET — query params + custom header",
      "method": "GET",
      "url": "{{baseUrl}}/get",
      "params": [
        {
          "key": "page",
          "value": "1",
          "enabled": true
        },
        {
          "key": "q",
          "value": "hello",
          "enabled": true
        },
        {
          "key": "debug",
          "value": "true",
          "enabled": true
        }
      ],
      "headers": [
        {
          "key": "X-Demo",
          "value": "yon",
          "enabled": true
        }
      ],
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmethods"
    },
    {
      "name": "POST — JSON body",
      "method": "POST",
      "url": "{{baseUrl}}/post",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "json",
        "content": "{\n  \"hello\": \"yon\",\n  \"n\": 42,\n  \"tags\": [\"http\", \"offline\"]\n}"
      },
      "folderId": "fmethods"
    },
    {
      "name": "PUT — JSON body",
      "method": "PUT",
      "url": "{{baseUrl}}/put",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "json",
        "content": "{ \"id\": 7, \"name\": \"updated\" }"
      },
      "folderId": "fmethods"
    },
    {
      "name": "DELETE",
      "method": "DELETE",
      "url": "{{baseUrl}}/delete",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmethods"
    },
    {
      "name": "Headers echo",
      "method": "GET",
      "url": "{{baseUrl}}/headers",
      "headers": [
        {
          "key": "X-Trace-Id",
          "value": "abc-123",
          "enabled": true
        },
        {
          "key": "Accept",
          "value": "application/json",
          "enabled": true
        }
      ],
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmethods"
    },
    {
      "name": "PATCH — echo method",
      "method": "PATCH",
      "url": "{{baseUrl}}/anything",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "json",
        "content": "{\n  \"op\": \"replace\",\n  \"value\": 7\n}"
      },
      "folderId": "fmethods"
    },
    {
      "name": "Bearer auth (inherits collection token)",
      "method": "GET",
      "url": "{{baseUrl}}/bearer",
      "auth": {
        "kind": "inherit"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fauth"
    },
    {
      "name": "Basic auth (overrides collection)",
      "method": "GET",
      "url": "{{baseUrl}}/basic-auth/alice/secret",
      "auth": {
        "kind": "basic",
        "username": "alice",
        "password": "secret"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fauth"
    },
    {
      "name": "Status 404 (orange)",
      "method": "GET",
      "url": "{{baseUrl}}/status/404",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fstatus"
    },
    {
      "name": "Status 500 (red)",
      "method": "GET",
      "url": "{{baseUrl}}/status/500",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fstatus"
    },
    {
      "name": "Redirect → /get (follows)",
      "method": "GET",
      "url": "{{baseUrl}}/redirect",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fstatus"
    },
    {
      "name": "Options — don't follow the redirect (per-request)",
      "method": "GET",
      "url": "{{baseUrl}}/redirect",
      "auth": {
        "kind": "inherit"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fstatus",
      "options": {
        "followRedirects": false
      },
      "assertions": [
        {
          "source": "status",
          "op": "equals",
          "expected": "302",
          "enabled": true
        },
        {
          "source": "header",
          "expr": "Location",
          "op": "contains",
          "expected": "/get",
          "enabled": true
        }
      ]
    },
    {
      "name": "Pretty JSON (syntax colour)",
      "method": "GET",
      "url": "{{baseUrl}}/json",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fformats"
    },
    {
      "name": "GET — XML response",
      "method": "GET",
      "url": "{{baseUrl}}/xml",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fformats"
    },
    {
      "name": "POST — XML body",
      "method": "POST",
      "url": "{{baseUrl}}/xml",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "xml",
        "content": "\u003corder id=\"1001\"\u003e\u003citem sku=\"A1\"\u003eWidget\u003c/item\u003e\u003citem sku=\"B2\"\u003eGadget\u003c/item\u003e\u003c/order\u003e"
      },
      "folderId": "fformats"
    },
    {
      "name": "GET — HTML page",
      "method": "GET",
      "url": "{{baseUrl}}/html",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fformats"
    },
    {
      "name": "GET — SOAP envelope",
      "method": "GET",
      "url": "{{baseUrl}}/soap",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fformats"
    },
    {
      "name": "Large body (\u003e 256 KB, truncates)",
      "method": "GET",
      "url": "{{baseUrl}}/large",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fbig"
    },
    {
      "name": "Slow 10s (test Cancel / timeout)",
      "method": "GET",
      "url": "{{baseUrl}}/slow",
      "params": [
        {
          "key": "seconds",
          "value": "10",
          "enabled": true
        }
      ],
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fbig"
    },
    {
      "name": "PNG image (inline preview)",
      "method": "GET",
      "url": "{{baseUrl}}/image/png",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmedia"
    },
    {
      "name": "JPEG image (inline preview)",
      "method": "GET",
      "url": "{{baseUrl}}/image/jpeg",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmedia"
    },
    {
      "name": "GIF image (inline preview)",
      "method": "GET",
      "url": "{{baseUrl}}/image/gif",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmedia"
    },
    {
      "name": "PNG as octet-stream (magic-byte sniff)",
      "method": "GET",
      "url": "{{baseUrl}}/image/octet",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmedia"
    },
    {
      "name": "PDF (Save… / Open panel)",
      "method": "GET",
      "url": "{{baseUrl}}/pdf",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmedia"
    },
    {
      "name": "PDF as octet-stream (magic-byte sniff)",
      "method": "GET",
      "url": "{{baseUrl}}/pdf/octet",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmedia"
    },
    {
      "name": "Text starting \"BM\" — must stay text, not an image",
      "method": "GET",
      "url": "{{baseUrl}}/text-bm",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      },
      "folderId": "fmedia"
    },
    {
      "name": "Assertions — check the JSON response",
      "method": "GET",
      "url": "{{baseUrl}}/json",
      "auth": {
        "kind": "inherit"
      },
      "body": {
        "type": "none"
      },
      "folderId": "ftestchain"
    },
    {
      "name": "Capture — grab id + name (step 1 of 2)",
      "method": "GET",
      "url": "{{baseUrl}}/json",
      "auth": {
        "kind": "inherit"
      },
      "body": {
        "type": "none"
      },
      "folderId": "ftestchain"
    },
    {
      "name": "Chain — use {{userId}} captured above (step 2 of 2)",
      "method": "GET",
      "url": "{{baseUrl}}/get",
      "params": [
        {
          "key": "user",
          "value": "{{userId}}",
          "enabled": true
        },
        {
          "key": "app",
          "value": "{{appName}}",
          "enabled": true
        }
      ],
      "auth": {
        "kind": "inherit"
      },
      "body": {
        "type": "none"
      },
      "folderId": "ftestchain"
    }
  ]
}
